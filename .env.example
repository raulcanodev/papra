# Mandatory
APP_BASE_URL=https://tu-dominio.com
AUTH_SECRET=  # genera con: openssl rand -hex 48

# Marca pública (puedes cambiarla sin tocar la interfaz)
VITE_APP_NAME=Paqui
VITE_APP_TAGLINE=Tu negocio, por fin en orden.
VITE_APP_DESCRIPTION=Documentos, facturas y finanzas en un único espacio de trabajo.

# Base de datos PostgreSQL (Supabase en producción)
# En Supabase: Project Settings > Database > Connection string > "Session pooler" (puerto 5432, compatible IPv4)
# También vale el "Transaction pooler" (puerto 6543), se desactivan los prepared statements automáticamente
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Local (dev): docker compose -f docker-compose.dev.yml up -d
# DATABASE_URL=postgresql://papra:papra@localhost:5435/papra_dev
# DATABASE_POOL_MAX_CONNECTIONS=10

# Registro de nuevos usuarios (desactívalo tras crear tu cuenta)
AUTH_IS_REGISTRATION_ENABLED=true

# Login con Google
# En Google Cloud Console crea un cliente OAuth 2.0 de tipo "Aplicación web".
# Origen autorizado: el mismo valor de APP_BASE_URL (sin barra final)
# URI de redirección: https://tu-dominio.com/api/auth/callback/google
AUTH_PROVIDERS_GOOGLE_IS_ENABLED=true
AUTH_PROVIDERS_GOOGLE_CLIENT_ID=
AUTH_PROVIDERS_GOOGLE_CLIENT_SECRET=

# Almacenamiento de documentos: filesystem (default), s3, azure
DOCUMENT_STORAGE_DRIVER=

# Cloudflare R2 (o cualquier S3-compatible) — solo si DOCUMENT_STORAGE_DRIVER=s3
DOCUMENT_STORAGE_S3_ACCESS_KEY_ID=
DOCUMENT_STORAGE_S3_SECRET_ACCESS_KEY=
DOCUMENT_STORAGE_S3_BUCKET_NAME=
DOCUMENT_STORAGE_S3_REGION=auto
DOCUMENT_STORAGE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# DOCUMENT_STORAGE_S3_FORCE_PATH_STYLE=false  # activa para MinIO

# Cifrado de documentos (AES-256-GCM) — funciona con cualquier driver
# Genera la clave con: openssl rand -hex 32
DOCUMENT_STORAGE_ENCRYPTION_IS_ENABLED=false
DOCUMENT_STORAGE_DOCUMENT_KEY_ENCRYPTION_KEYS=  # clave hex de 64 caracteres — NO LA PIERDAS

# Emails: logger (sin envío), smtp, resend
EMAILS_DRIVER=

# AI Assistant (opcional — al menos 1 key necesaria para habilitar el chat)
AI_GROK_API_KEY=
AI_GOOGLE_API_KEY=
AI_OPENAI_API_KEY=
AI_ANTHROPIC_API_KEY=
