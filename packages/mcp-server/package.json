{
  "name": "@paqui/mcp-server",
  "type": "module",
  "version": "0.1.0",
  "description": "Model Context Protocol server for Paqui.",
  "license": "AGPL-3.0-or-later",
  "exports": {
    ".": "./dist/server.js",
    "./api": "./dist/api.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "bin": {
    "paqui-mcp": "./bin/paqui-mcp.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@paqui/tool-catalog": "workspace:*",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=20"
  }
}
