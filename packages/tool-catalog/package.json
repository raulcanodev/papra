{
  "name": "@paqui/tool-catalog",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Single source of truth of the tools exposed to AI clients: consumed by the MCP server and by the in-app assistant.",
  "license": "AGPL-3.0-or-later",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "dev": "pnpm build:watch",
    "docs": "tsx scripts/generate-tools-readme.ts"
  },
  "dependencies": {
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
